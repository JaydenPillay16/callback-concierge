        }
      },
      "reason-input": {
        "position": {
          "x": 450,
          "y": 40
        }
      },
      "billing": {
        "position": {
          "x": 700,
          "y": -100
        }
      },
      "technical": {
        "position": {
          "x": 700,
          "y": 40
        }
      },
      "general": {
        "position": {
          "x": 700,
          "y": 180
        }
      },
      "invoke-lambda": {
        "position": {
          "x": 950,
          "y": 40
        }
      },
      "confirmation": {
        "position": {
          "x": 1200,
